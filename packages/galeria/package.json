{
  "name": "zkit-galeria",
  "version": "1.0.0",
  "description": "Shared-transition image and video gallery for web and React Native.",
  "private": false,
  "license": "MIT",
  "author": "Concur",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "react-native": "./src/react-native/index.ts",
      "default": "./src/react-native/index.ts"
    },
    "./styles.css": "./dist/galeria.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Concur-max/zkit.git",
    "directory": "packages/galeria"
  },
  "homepage": "https://github.com/Concur-max/zkit/tree/main/packages/galeria",
  "bugs": {
    "url": "https://github.com/Concur-max/zkit/issues"
  },
  "files": [
    "android",
    "dist",
    "expo-module.config.json",
    "ios",
    "src",
    "scripts",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run build && node scripts/verify.cjs"
  },
  "dependencies": {
    "react-native-is-edge-to-edge": "^1.1.6"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
